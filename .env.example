# Copy this file to .env and fill in your own values. NEVER commit .env.

# ── Binance (main trading account) ───────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ── Binance (arbitrage account, optional) ────────────────
ARB_BINANCE_API_KEY=your_arb_binance_api_key
ARB_BINANCE_SECRET=your_arb_binance_api_secret

# ── Telegram notifications ───────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Runtime flags ────────────────────────────────────────
TESTNET=true
PAPER_MODE=true
ARB_PAPER_MODE=true
USE_RUST_ENGINE=true
LOG_LEVEL=INFO

# ── Risk / sizing (see core/risk_manager.py) ─────────────
TRADE_AMOUNT=0
MAX_LEVERAGE=40
